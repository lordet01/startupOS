# Server-only. Never expose this value in config.js or browser code.
OPENAI_API_KEY=replace_in_vercel_environment
OPENAI_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_M=0.10
OPENAI_OUTPUT_USD_PER_M=0.50
OPENAI_MAX_OUTPUT_TOKENS=3400
ALLOWED_ORIGIN=https://startup-os-beige.vercel.app

# Builder runtime
OPENAI_BUILD_MODEL=gpt-6-luna
OPENAI_BUILD_MAX_OUTPUT_TOKENS=2200

# Internal Vercel publishing (operator-only)
VERCEL_TEAM_ID=team_5Xvxmw5pZpjXlHR1L4Cve7Rs
VERCEL_PUBLISH_TOKEN=replace_with_internal_vercel_token

# Public Firebase Web App configuration. Never put a service-account private key here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Firebase configuration automatically requires login for workspace mutation APIs.
# This flag can also close the API before Firebase setup is complete.
STARTUPOS_AUTH_REQUIRED=false
