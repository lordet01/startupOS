{
  "fluid": true,
  "functions": {
    "api/runtime.js": { "maxDuration": 60 },
    "api/build.js": { "maxDuration": 90 },
    "api/publish.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
