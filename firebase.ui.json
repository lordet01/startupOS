{
  "functions": [
    {
      "source": ".firebase-ui-build/functions",
      "codebase": "startupos",
      "predeploy": [
        "node firebase/build-ui.cjs"
      ]
    }
  ],
  "hosting": {
    "public": ".firebase-ui-build/public",
    "predeploy": [
      "node firebase/build-ui.cjs"
    ],
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "startupApi",
          "region": "asia-east1"
        }
      },
      {
        "source": "**",
        "function": {
          "functionId": "startupWeb",
          "region": "asia-east1",
          "pinTag": true
        }
      }
    ],
    "headers": [
      {
        "source": "/login{,/**,.html}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  }
}
